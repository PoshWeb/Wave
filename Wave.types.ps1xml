                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Data</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Data
.DESCRIPTION
    Gets the byte[] describing a wave.
#&gt;
[CmdletBinding()]
param()

# If we have not cached our data chunk
if (-not $this.'#data') {
    # read chunks
    $null = $this.Chunk
    # If there is still nothing
    if (-not $this.'#data') {        
        return # return nothing.
    }
}
# Use the comma operator to return a list containin the data, 
# so that it unrolls to the data itself (rather than tries to stream the bytes)
return ,$this.'#data'
                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets Wave Data
.DESCRIPTION
    Sets the PCM data in a wave.
.LINK
    https://en.wikipedia.org/wiki/Pulse-code_modulation
#&gt;
param(
# The Pulse Code Modulation wave data.
[byte[]]$data
)

if (-not ($this.CanSeek -and $this.CanWrite)) {
    throw "Must be able to seek and write a stream to change the wave"
}

# If we have no data start
if (-not $this.'#data.start') {
    # read chunks
    $null = $this.Chunk
    # If we still have no data start, return.
    if (-not $this.'#data.start') {
        return
    }
}

# Seek to our data start plus 4
$null = $this.Seek($this.'#data.start' + 4, 'Begin')
# and prepare a writer
$writer = [IO.BinaryWriter]::new($this)
# Write our new data length
$writer.Write([uint32]$data.Length)
# then write our data
$this.Write($data, 0, $data.Length)
# $writer.Write($data)

# Then update our data chunk.
$this.'#data' = $data

# and seek to near the start of the file.
$null = $this.Seek(4, 'Begin')
# Then write our stream length, minus 8 bytes
$writer.Write([uint32]($this.Length - 8))

# and set our position back to the start.
$null = $this.Seek(0, 'Begin')

# Nullify any cached values we may have
$this | Add-Member NoteProperty '#Samples' $null -Force
$this | Add-Member NoteProperty '#Angle' $null -Force
$this | Add-Member NoteProperty '#Vector2' $null -Force
$this | Add-Member NoteProperty '#Vector3' $null -Force
                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>DataUrl</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Wave Data Url
.DESCRIPTION
    Gets the Wave as a Data Url.
    
    This can be used as an audio source `&lt;audio src&gt;`.
#&gt;
"data:audio/wav;base64,$(
    [Web.HttpUtility]::UrlPathEncode(
        [Convert]::ToBase64String(            
            $this.ToArray()                
        )
    )
)"

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Duration</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Duration        
.DESCRIPTION
    Gets the duration of a wave file.

    This should be the length of it's PCM data, divided by bytes per second.
#&gt;
$bps = $this.BytesPerSecond
if ($bps) {
    [TimeSpan]::FromSeconds($this.'#data'.length / $bps)
}


                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>FoldingFrequency</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets a Wave's Folding Frequency
.DESCRIPTION
    Gets the maximum frequency that waveform can encode without distortion.

    This is half of the sampling rate.
    
    It is commonly called the "folding frequency", 
    and technically known as the Nyquist Frequency.
.NOTES
    Imagine one second of audio drawn on a piece of graphing paper,
    with zero at the middle.

    If we folded it in half, we would have the complete 
    up cycle and down cycle of the wave.
.LINK
    https://en.wikipedia.org/wiki/Nyquist_frequency
#&gt;
param()

$this.SampleRate/2

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Genre</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave's Genre 
.DESCRIPTION
    Gets the Wave Genre metadata.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    Genre metadata is stored
    with the four letter word key: `IGNR`
#&gt;

return $this.metadata.Genre

                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets the Wave's Genre
.DESCRIPTION
    Sets the Wave's Genre metadata.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    Genre metadata is stored
    with the four letter word key: `IGNR`
#&gt;
param([string]$Genre)

$metadata = $this.metadata
$metadata.Genre = $Genre
$this.Metadata = $metadata

                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>HTML</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets an HTML wave
.DESCRIPTION
    Gets a waveform as HTML.  
    
    By default, renders an `&lt;audio&gt;` element with the current wave as the source.
.NOTES
    This can be customized by setting the HTML.
#&gt;
param()
if ($this.'#HTML') {
    @(foreach ($object in $this.'#HTML') {
        if ($object -is [xml]) {
            $object.OuterXml
        }
        elseif ($object.html) {
            $object.html
        } elseif ($object.ToString) {
            $object.ToString()
        }
    }) -join [Environment]::NewLine
    return 
}
return "&lt;audio controls='' src='$($this.DataUrl)'&gt;&lt;/audio&gt;"
                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets Wave HTML
.DESCRIPTION
    Sets a custom HTML representation of a wave.

    By default, a wave in is just an `&lt;audio&gt;` element,
    with the source being the wave's `.DataUrl`.

    This allows us to show a Wave in HTML any way we wish.
.NOTES
    By default, a wave in is just an `&lt;audio&gt;` element,
    with the source being the wave's `.DataUrl`.

    While this works, 
    it does not provide any surrounding context or allow for customization.

    By allowing a custom value, we can add simple surrounding context
    (like the name of the note or tune).

    We can also change how the audio is displayed or used.
#&gt;
param()

$this | Add-Member NoteProperty '#HTML' $args -Force
                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Instrument</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Instrument
.DESCRIPTION
    Gets the instruments used to play a wave, if any have been set.    
.NOTES
    At present, this stores the instrument list in memory.
    
    It does not attempt any detection of instruments for existing waves.
#&gt;
return $this.'#Instrument'

                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets Wave Instruments
.DESCRIPTION
    Sets the Instruments used to play a wave.
#&gt;
$this | Add-Member NoteProperty '#Instrument' $args -Force
                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>MaximumVolume</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Maximum Volume
.DESCRIPTION
    Gets the Maximum Volume from a wave.
.NOTES
    This is the delta between the maximum and minimum sample
#&gt;
param()
# Get our samples as a `[double[]]`
[double[]]$samples = $this.Samples

# If we did not have any samples,
# the maximum volume is obviously zero.
if (-not $samples) { return 0 }

# Otherwise, find the delta between max and min
return [Linq.Enumerable]::Max($samples) - [Linq.Enumerable]::Min($samples)    

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Melody</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Melody
.DESCRIPTION
    Gets the melody played by the wave, if one has been set.

    Each step in the melody is effectively
    an instruction for what frequency to play and when.
.NOTES
    At present, this stores a melody in memory.
    
    It does not attempt any detection of melody for existing waves.
#&gt;
[OutputType([PSObject])]
param()

return $This.'#Melody'
                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets the Melody
.DESCRIPTION
    Sets the Melody of a Wave.

    The melody is the sequence of instructions the wave will play.
#&gt;
param()
$This | 
    Add-Member NoteProperty '#Melody' $args -Force -PassThru
                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>MetaData</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Metadata
.DESCRIPTION
    Gets Metadata about a Wave File.

    Wave files can include metadata in a LIST chunk

    Each piece of metadata is a 4-byte ASCII identifier,
    a 4-byte length, and a string.
    
    If the identifier contains `XML` (or is `MATH`),
    the string will be decoded as UTF-8 and cast to `[XML]`

    If the identifier does not match `XML`, `html`, or `json`,
    the string will be decoded as ASCII.
.NOTES    
    Each header must start at a WORD boundary, or two bytes.
    
    If the ASCII string had an odd number of characters, the next byte will be ignored.
#&gt;
[OutputType([Collections.IDictionary])]
param()

$waveModule = Get-Module Wave
# If we have no cached list
if (-not $this.'#list') {
    # read chunks.
    $null = $this.Chunk
    # Return if we still have no cached list
    if (-not $this.'#list') { 
        return [Ordered]@{
            Software = "$($waveModule.Name) $($waveModule.Version) $($waveModule.ProjectUri)"
        }
    }
}

# Almost everything in metadata is encoded in ASCII
# (Wave file predate UTF-8 encoding by about a decade)

# We want to return metadata as a dictionary
$metadata = [Ordered]@{}

# We also want to make names more readable where we can
$LongNames = [Ordered]@{
    # Standard Wave Information
    IARL = "ArchiveLocation"
    IART = "Artist"
    ICMS = "Commissioned"
    ICMT = "Comment"
    ICOP = "Copyright"
    ICRD = "CreationDate"
    IENG = "Engineer"
    IGNR = "Genre"
    IKEY = "Keywords"
    IMED = "Medium"
    INAM = "Title" # (Technically `Name`)
    IPRD = "Album" # (Technically `Product`)
    IPRT = "TrackNumber"
    ISBJ = "Subject"
    ISFT = "Software"
    ISRC = "Source"
    ISRF = "SourceForm"
    ITCH = "Technician"

    # Supported ID3 tags 
    TBPM = "BPM"

    # Extended Information / Direct Embedding
    json = 'json'
    html = 'html'
    math = 'MathML'
    MXML = 'MusicXML'
    MIDI = 'Midi'
}

# Get our list bytes
$list = $this.'#list'

filter bucket([string]$key, [Collections.IDictionary]$Bucket) {
    $value =  $_
    if ((-not $key) -or (-not $Bucket) ) { return }
        
    if (-not $Bucket[$key]) {
        # put it in the dictionary
        $Bucket[$key] = $value
    }
    else {
        # otherwise make it a bucket and store the next value.
        $Bucket[$key] = @($Bucket[$key]) + ($value)
    }
}

# The first four bytes of a list are always `INFO`,
# so walk over our list, starting at 4 and incrementing as we read.
for ($index = 4; $index -lt $list.Length; ) {
    # Get the ID
    $metaDataId = [Text.Encoding]::ASCII.GetString($list, $index, 4) 
    # and advance four bytes.
    $index +=4
    # Get the chunk length 
    $metadataLength = [BitConverter]::ToUInt32($list,$index)
    # and advance four bytes
    $index +=4    

    # While _most_ content in LIST sections is ASCII,
    # the Broadcast Wave Standard allows a UTF-8 encoded XML.
    
    $fourByteId = $metaDataId

    if ($LongNames[$metaDataId]) {
        $metaDataId = $LongNames[$metaDataId]
    }

    # Rather than special case this one scenario, 
    # we will presume anything with the letters `XML` in the key is UTF-8 XML.
    if (
        $fourByteId -match 'XML' -or 
        $fourByteId -match 'MATH'
    ) {
        $value = [Text.Encoding]::UTF8.GetString($list, $index, $metadataLength).Trim()
        
        # If we can cast the value to XML
        if ($value -as [xml]) {
            # Then update the value to it's xml
            $value = $value -as [xml]            
            $value | bucket $MetaDataId $metadata
        }
        # If we could not cast to XML
        else
        {
            # two tears in a bucket.
            $value | bucket $MetaDataId $metadata
        }
    }
    # If the four byte id is json 
    elseif ($fourByteID -match 'json') {
        # read it as utf-8
        $value = [Text.Encoding]::UTF8.GetString($list, $index, $metadataLength).Trim()
        
        # and try to convert it from json
        try {
            $value = [Microsoft.PowerShell.Commands.JsonObject]::ConvertFromJson($value, [ref]$null)    
            $value | bucket $MetaDataId $metadata
            
        } catch {
            # If we could not, warn
            Write-Warning "Non-Json in json at $($index): $_"
            # and bucket the metadata.
            $value | bucket $MetaDataId $metadata
        }        
    }
    else {
        # Get the string
        $value = [Text.Encoding]::ASCII.GetString($list, $index, $metadataLength).Trim()
                
        $value | bucket $MetaDataId $metadata
    }
    
    # and advance by the string length.
    $index += $metadataLength
    # If our index was odd
    if ($index % 2) {
        $index++ # advance one more byte.
    }
}

foreach ($key in @($metadata.Keys)) {
    if ($key -match 'Date$') {
        $date = $metadata[$key] -as [DateTime]        
        if ($date) {
            $metadata[$key] = $date
        }
        elseif ($metadata[$key] -match '(?&lt;y&gt;\d{4})') {
            $metadata[$key] = [DateTime]::new($matches.y, 1, 1)
        }
    }
    if ($null -ne ($metadata[$key] -as [double])) {        
        $metadata[$key] = $metadata[$key] -as [double]
        if (
            ($metadata[$key] -as [int]) -eq [Math]::Floor($metadata[$key])
        ) {
            $metadata[$key] = $metadata[$key] -as [int]
        }
    }
}

if (-not $metadata.Software) {
    $metadata.Software = "$($waveModule.Name) $($waveModule.Version) $($waveModule.ProjectUri)" 
}

# Return our metadata.
return $metadata
                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets Wave Metadata
.DESCRIPTION
    Sets Metadata about a Wave File.

    Wave files can include metadata in a LIST chunk

    Each piece of metadata is a 4-byte ASCII identifier,
    a 4-byte length, and an ASCII string.
.NOTES    
    Each header must start at a WORD boundary, or two bytes.
    
    If the ASCII string had an odd number of characters, the next byte will be ignored.
#&gt;
param([Collections.IDictionary]$MetaData)

$shortNames = [Ordered]@{
    "ArchiveLocation" = 'IARL'
    "Artist" = 'IART'
    'BPM' = 'TBPM'
    'BeatsPerMinute' = 'TBPM'
    "Commissioned" = 'ICMS'
    "Comment" ='ICMT'
    "Comments" ='ICMT'
    "Copyright" = 'ICOP'
    "CreationDate"= 'ICRD'
    "Engineer"= 'IENG'
    "Genre"='IGNR'
    "Tag" = "IKEY"
    "Tags" = "IKEY"
    "Keyword"="IKEY"
    "Keywords"='IKEY'
    "Medium"='IMED'
    "Title"='INAM'
    'Album' = 'IPRD'
    "Product"= 'IPRD' 
    "TrackNumber"= 'IPRT'
    "Subject"= 'ISBJ'
    "Software" = 'ISFT'
    "Source"= 'ISRC'
    "SourceForm" =  'ISRF'
    "Technician" = 'ITCH'
    'MathML' = 'MATH'
    'MusicXML' = 'MusicXML'
    'json' = 'json'
    'midi' = 'MIDI'
}

# https://mediaarea.net/BWFMetaEdit/listinfo

# Start off by refreshing out chunk list
$this | Add-Member NoteProperty '#Chunk' $null -Force
$chunks = $this.Chunk

# We will need to locate the list start if we have one
$listStart = 0 

# Walk over each chunk
$afterList = foreach ($chunk in $chunks) {
    # we will put the data into the first LIST chunk we see
    if ($chunk.id -eq 'LIST') {
        $listStart = $chunk.start
    }
    # and we will keep track of all chunks after this location
    elseif ($listStart) {
        $chunk
    }
}

# If we do not have a LIST
if (-not $listStart) {
    # Put it before the last chunk (often `data`)
    $listStart = $chunks[-1].start
    $afterList = @($chunks[-1])
}

# Create a writer
$writer = [IO.BinaryWriter]::new($this)
# and seek to the list start
$null = $this.Seek($listStart, 'Begin')
# Then write the list
$writer.Write([Text.Encoding]::ASCII.GetBytes("LIST"))

filter ListItemBytes {
    $value = $_
    [Text.Encoding]::ASCII.GetBytes($shortKey)

    [byte[]]$ValueBytes = if (
        $shortKey -match 'xml' -or 
        $shortKey -match 'math' -or 
        $shortKey -match 'clix'
    ) {
        if ($value -is [xml]) {
            [Text.Encoding]::UTF8.GetBytes(
                $value.OuterXml
            )
        } else {
            [Text.Encoding]::UTF8.GetBytes("$($value)")
        }            
    }
    elseif ($shortKey -match 'json') {        
        [Text.Encoding]::Utf8.GetBytes(
            (ConvertTo-Json -InputObject $value -Depth 100)
        )
    }
    else {
        if ($value -is [DateTime]) {
            if ($key -eq 'ICRD') {
                [Text.Encoding]::ASCII.GetBytes("$(
                    ($value).ToString('yyyy-MM-dd')
                )")
            } else {
                [Text.Encoding]::ASCII.GetBytes($value.ToString('o'))
            }
        } else {
            # Get the bytes stored in the value
            [Text.Encoding]::ASCII.GetBytes("$($value)")
        }
    }

    [BitConverter]::GetBytes([uint32]$valueBytes.Length)
    $valueBytes
    if ($valueBytes.Length % 2) {
        [byte]0
    }    
}

# Collect our list data
[byte[]]$listData = @(
    # `LIST` chunks begin with the ASCII characters `INFO`.
    [Text.Encoding]::ASCII.GetBytes("INFO")
    # followed by a series of key-value pairs
    foreach ($key in $MetaData.Keys) {
        # If the metadata starts with punctuation, 
        # we do not want to save it.
        # This allows for temporary 
        # metadata that will not be persisted.
        if ($key -match '^\p{P}') {
            continue
        }
        # Each key can only be four ASCII characters.
        $shortKey = 
            # If the key was longer than four characters
            if ($shortNames[$key]) {
                $shortNames[$key]
            }
            elseif ("$key".Length -gt 4) {
                # take the first four characters
                "$key".Substring(0, 4)
            } else {
                # otherwise, pad right with spaces.
                "$key".PadRight(4, ' ')
            }
        
        $MetaData[$key] | ListItemBytes
    }
)
$writer.Write([uint32]$listData.Length)
$writer.Write($listData)

foreach ($after in $afterList) {
    $writer.Write([Text.Encoding]::ASCII.GetBytes($after.id))
    $writer.Write([uint32]$after.length)
    $writer.Write([byte[]]$after.data)
}

$null = $this.Seek(4, 'Begin')
# Then write our stream length, minus 8 bytes
$writer.Write([uint32]($this.Length - 8))

# and set our position back to the start.
$null = $this.Seek(0, 'Begin')

foreach ($prop in $this.psobject.properties) {
    if ($prop.Name -match '^#') {
        $prop.Value = $null
    }
}

return $this
                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>NoteFrequency</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    The Note Frequencies
.DESCRIPTION
    The frequencies for musical notes.
.NOTES
    Adapted from the [Web Audio API Keyboard Synth](https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API/Simple_synth)
.LINK
    https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API/Simple_synth
#&gt;
param([byte]$MaxOctave = 7)

if ($this.'#NoteFrequency') {
    return $this.'#NoteFrequency'
}

# These filters are here for reference

# Formula for a flat note, given a frequency
filter flat { $_ * [Math]::Pow(2, (-1/12)) }

# Formula for a sharp note, given a frequency
filter sharp { $_ / [Math]::Pow(2, (-1/12))}

# We hard code the first octave and below
$noteFrequency = [Ordered]@{    
    'A♭0' = 25.9565435987466
    A0 = 27.5
    "A♯0" = 29.13523509488062
    'B♭0' = 29.1352350948806
    B0 = 30.867706328507754
    'C♭1' = 30.8677063285078
    C1 = 32.70319566257483
    "C♯1" = 34.64782887210901
    'D♭1' = 34.647828872109
    D1 = 36.70809598967595
    "D♯1" = 38.89087296526011
    'e♭1' = 38.8908729652601
    E1 = 41.20344461410874
    'f♭1' = 41.2034446141087    
    F1 = 43.65352892912549
    "F♯1" = 46.2493028389543
    'g♭1' = 41.2034446141087
    "G1" = 48.99942949771866
    "G♯1" = 51.91308719749314
    'A♭1' = 51.9130871974931
    "A1" = 55.0
    "A♯1" = 58.27047018976124
    "B♭1" = 58.2704701897612
    "B1" = 61.73541265701551    
}

# For every additional octave
for ($octave = 2; $octave -le $MaxOctave; $octave++) {
    # get our notes in order
    $lastOctaveKeys = @($noteFrequency.Keys -match $($octave - 1))
    # go over each last note
    foreach ($lastOctave in $lastOctaveKeys) {
        # map the next note as double
        $noteFrequency["$($lastOctave -replace $(
            $octave - 1
        ), $octave)"] = $noteFrequency[$lastOctave] * 2
    }
}

# Add one more note for the final C
$noteFrequency["C$($MaxOctave + 1)"] = $noteFrequency."C$($MaxOctave)" * 2

foreach ($key in @($noteFrequency.Keys)) {
    $noteFrequency[$key].pstypenames.add('Frequency')
}

$this | Add-Member NoteProperty '#NoteFrequency' $noteFrequency -Force

return $noteFrequency

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>NoteGrammar</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Note Grammar
.DESCRIPTION
    Wave notes are a musical domain specific language.

    Defining a Grammar streamlines how we can work with them.
.NOTES
    ### Grammar Format

    The Grammar is defined in a simple primal format:

    It is an `[Ordered]` dictionary.

    The order defines the order of precedence.
    
    Each key is the name of an instruction.

    Each value is one or more literal strings or `[Regex]`

    The grammar is combined into a single regular expression,
    which is available in `.NotePattern`

    ### Grammar Maturity

    This Grammar is in currently in flux, 
    and should not be viewed as final or fully matured.

    Certain elements specified in the grammar are not yet supported:

    * `&lt;&gt;` (Open/Close Phrase) support is not yet implemented
    * `[]` (Open/Close Divide) only supports some partial syntax
    * `𝆱𝆲` (GlissandoUp/Down) are not yet implemented
#&gt;


[Ordered]@{
    OpenPhrase = '&lt;'
    ClosePhrase = '&gt;'
    OpenDivide = '['
    CloseDivide = ']'    
    UpTempo = '++'
    DownTempo = '--'
    Time1_1 = '𝅝'
    Time1_2 = '𝅗𝅥'
    Time1_4 = '𝅘𝅥'
    Time1_8 = '𝅘𝅥𝅮'
    Time1_16 = '𝅘𝅥𝅯'
    Time1_32 = '𝅘𝅥𝅰'
    Time1_64 = '𝅘𝅥𝅲'
    Time1_128 = '𝅘𝅥𝅲'
    GlissandoUp = '𝆱'
    GlissandoDown = '𝆲'    
    Rest1_1 = '𝄻'
    Rest1_2 = '𝄼'
    Rest1_4 = '𝄽'
    Rest1_8 = '𝄾'
    Rest1_16 = '𝄿'
    Rest1_32 = '𝅀'    
    Rest1_64 = '𝅁'
    Multiply = [Regex]::new('\*(?&lt;scale&gt;[\d\.]+)')
    Divide = [Regex]::New('/(?&lt;scale&gt;[\d\.]+)')
    RatioTime = [Regex]::New('\:(?&lt;scale&gt;[\d\.]+)')
    Repeat = [Regex]::New('!(?&lt;scale&gt;[\d+])')
    DECPS = [regex]::new('
        (?&lt;decSequence&gt;
            \e\[
            (?&lt;decVolume&gt;[0-7]);
            (?&lt;decDuration&gt;\d+);
            (?:
                (?&lt;decNote&gt;\d+
            );?){1,}
            ,~
            [\s\r\n]{0,}
        ){1,}',
        'IgnoreCase,IgnorePatternWhitespace'
    )    
    Emoji = [Regex]::new("[\p{IsHighSurrogates}\p{IsLowSurrogates}\p{IsVariationSelectors}\p{IsCombiningHalfMarks}]+")    
    AtTime = [Regex]::new('\@(?&lt;scale&gt;[\d\.]+)')
    Rest = [Regex]::new('
        (?&gt;
            ~|            # Strudel notation            
            rest|silence| # Common english
            [xz]|         # ABC notation
            ø             # Notemoji notation
        )
    ','IgnoreCase,IgnorePatternWhitespace')
    BeepCommand = [Regex]::new('
        Beep                   # beep
        (?&lt;beepSequence&gt;
            (?:-n)?            # Followed by an option -n (new beat)
            \s{1,}             # and at least one space
            (?&gt;
                -f\s{0,}(?&lt;beepFrequency&gt;[\d\.]+)\s{1,}
                |
                -l\s{0,}(?&lt;beepDuration&gt;[\d\.]+)\s{1,}
                |
                -d\s{0,}(?&lt;beepDelay&gt;[\d\.]+)\s{1,}
                |
                -r\s{0,}(?&lt;beepRepeat&gt;\d+)\s{1,}
            ){1,}
        ){1,}        
    ','IgnoreCase,IgnorePatternWhitespace')
    Beep = [Regex]::new(
        '
        Beep                   # Beep
        \s{0,}                 # Followed by optional whitespace
        \p{Ps}?                # Optional starting punctuation
        (?&lt;frequency&gt;[\d\.]+)  # Frequency
        \s{0,}                 # Optional whitespace
        \p{P}                  # Intermedia punctuation
        \s{0,}                 # Optional whitespace
        (?&lt;duration&gt;[\d\.]+)   # Duration
        \s{0,}                 # Optional whitespace
        \p{Pe}                 # Ending punctuation
        ',
        'IgnoreCase,IgnorePatternWhitespace'
    )
    MidiNote = [Regex]::New(
        '
        (?&gt;
            # Prefixed midi note
            m(?:idi)?\s{0,}(?&lt;midiNumber&gt;\-?[\d\.]+)
            |
            # Suffixed midi note
            (?&lt;midiNumber&gt;\-?[\d\.]+)m(?:idi)?\s{0,}
        )
        ',
        'IgnoreCase,IgnorePatternWhitespace'
    )    
    ExactFrequency = [Regex]::new(
        '(?&gt;
            (?&lt;frequency&gt;\-?\d+(\.\d+)?)(?&lt;unit&gt;(?&gt;hz|㎐))
            |
            (?&lt;unit&gt;(?&gt;hz|㎐))(?&lt;frequency&gt;\-?\d+(\.\d+)?)
        )',        
        'IgnoreCase,IgnorePatternWhitespace'
    )
    Sleep = [Regex]::new(
        '
        Sleep                  # Sleep
        \s{0,}                 # Followed by optional whitespace
        \p{Ps}?                # Optional starting punctuation
        \s{0,}                 # Optional whitespace
        (?&lt;duration&gt;[\d\.]+)   # Duration
        \s{0,}                 # Optional whitespace        
        \p{Pe}?                # Optional ending punctuation',
        'IgnoreCase,IgnorePatternWhitespace'
    )
    # Letter notes are one of the more challenging parts of the grammar
    # We only want to match letters within words that are all notes.
    LetterNote = [Regex]::new('
    # Do not match if we preceed a letter 
    # or punctuation that is not a-g
    # followed by any number of a-g letters
    (?&lt;![\p{L}\p{P}-[abcdefg\|\,\.]][abcdefg\|]{0,})
    (?&lt;pitch&gt;
        (?&gt;
            (?&lt;flat&gt;[\u266d_])
            |
            (?&lt;sharp&gt;[\#\u266f\^])
        )
    )?
    (?&lt;letter&gt;[a-g]) # a letter between a and g
    # as long as the next character is not a letter and not a-g or s.
    (?![\p{L}-[abcdefgs]])
    (?: 
        # Then an optional flat/sharp alter
        # and a number
        (?&gt;
            # If it is a `b` flat, 
            # it has to be followed by an octave.
            (?&lt;flat&gt;b)
                (?&lt;octave&gt;[1-8])
            |            
            # If it is a notemoji flat or underscore
            (?&lt;flat&gt;[\u266d_])
                # the octave is optional
                (?&lt;octave&gt;[1-8])?
            |
            # If it is a notemoji sharp, pound sign, caret, or s
            (?&lt;sharp&gt;[\#\u266f\^s])
                # the octave is optional
                (?&lt;octave&gt;[1-8])?
            |
            # If there was no sharp or flat, the octave can still be present
            (?&lt;octave&gt;[1-8])
        )
    )?
     # an optional octave
    ', 'IgnoreCase, IgnorePatternWhitespace'        
    )

    Range = [Regex]::New('\.\.')

    Combine = [Regex]::New(',')
    # Simple decimal match.
    Decimal = [Regex]::new('-?\d+(?:\.\d+)?', 'IgnoreCase')
}

                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Notemoji</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Notemoji
.DESCRIPTION
    Gets Notemoji.

    This maps a beat time signature to emoji.

    |Note Length|Name|Emoji|Hex|
    |-|-|-|-|
    |1|Whole Note|𝅝|0x1d15d|
    |1/2|Half Note|𝅗𝅥|0x1d15e|
    |1/4|Quarter Note|𝅘𝅥|0x1d15f|
    |1/8|Eighth Note|𝅘𝅥𝅮|0x1d160|
    |1/16|Sixteenth Note|𝅘𝅥𝅯|0x1d161|
    |1/32|Thirty-Second Note|𝅘𝅥𝅰|0x1d162|
    |1/64|Sixty-fourth Note|𝅘𝅥𝅱|0x1d163|
    |1/128|One hundred Twenty-Eighth Note|𝅘𝅥𝅲|0x1d164|
.NOTES
    The Unicode standard contains symbols for note lengths in the range `0x1d15d..0x1d164`.

    This property provides an easy-to-read mapping of time signature to note.

    Because the note range is sequential, we can calculate the time signature by index:

    ~~~PowerShell
    $notemoji = "𝅝","𝅗𝅥","𝅘𝅥","𝅘𝅥𝅮","𝅘𝅥𝅯","𝅘𝅥𝅰","𝅘𝅥𝅲","𝅘𝅥𝅲"
    $noteTime = '𝅗𝅥'
    $noteRatio = $notemoji.IndexOf($noteTime) + 1 
    ~~~
#&gt;
return "𝅝","𝅗𝅥","𝅘𝅥","𝅘𝅥𝅮","𝅘𝅥𝅯","𝅘𝅥𝅰","𝅘𝅥𝅲","𝅘𝅥𝅲"
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>NotePattern</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Note Pattern
.DESCRIPTION
    Gets the regular expression used to match notes.
.NOTES
    This expression is derived from the Note Grammar.

    It combines every pattern defined in the grammar into a single `[Regex]`

    This pattern uses an atomic or `(?&gt;a|b)` to ensure 
    only one grammar element at a time matches.

    We can view the captured information about each pattern as a state, 
    and view each match as a change in state.

    This allows us to parse notes using a finite state machine.
.LINK
    Wave.get_NoteGrammar
#&gt;
[OutputType([Regex])]
param()
$grammar = $this.NoteGrammar

# Combine all patterns in the grammar
$patterns = @(
    foreach ($key in $grammar.Keys) {
        $pattern = # Each pattern is in a named capture group
            "(?&lt;$key&gt;",
            $(
            # If the grammar was a byte literal
            if ($grammar[$key] -is [byte[]]) {
                [Regex]::new(
                    [Regex]::Escape(
                        [Text.Encoding]::UTF8.GetString($grammar[$key])
                    )
                )
            }
            elseif ($grammar[$key] -isnot [Regex]) { 
                # make it a pattern that matches any of the supplied values
                [Regex]::new($(                
                    @(foreach ($const in $grammar[$key]) {
                        [Regex]::Escape("$const")
                    }) -join '|'
                ))
            } else {
                # Otherwise, stringify the pattern (this supercedes any options)
                "$($grammar[$key])"
            }
            ),')' -join [Environment]::NewLine

        # Try to create a new pattern
        try {
            [Regex]::new($pattern, 'IgnoreCase,IgnorePatternWhitespace')
        } catch {
            # If that fails, capture the exception
            $ex = $_
            # PowerShell generally does not show exceptions on a property get.
            # However, it can return an error explicitly
            try {
                # So throw an exception indicating which pattern failed
                throw "$key has an invalid $pattern : $ex"
            } catch {
                # and then return that exception.
                return $_
            }
            
        }
    }
)

# If all of the patterns were valid, combine them into an atomic or.
$combinedPattern = "(?&gt;
$(
    # Join each of the patterns by an or `|`
    # surrounded by two newlines
    # (for readability of an incredibly long regular expression)
    $patterns -join (        
        ([Environment]::NewLine * 2) + '|' + ([Environment]::NewLine * 2)
    )
)
)"

# Try to create a new pattern.
# Always ignore case and pattern whitespace, 
# and set a timeout of a second.
try {
    [Regex]::new($combinedPattern, 'IgnoreCase,IgnorePatternWhitespace','00:00:01')
} catch {
    return $_
}


                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Peak</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Peaks
.DESCRIPTION
    Gets the points in the wave that are peaks.
.OUTPUTS
    Outputs a `[Numerics.Vector2]` where the X is the sample number and the Y is the sample. 
#&gt;
param()
[double[]]$samples = $this.Samples
for ($sampleNumber = 1 ; $sampleNumber -lt ($samples.Length - 1); $sampleNumber++) {
    # If the sample
    if (
        # is greater than the preceeding sample and
        $samples[$sampleNumber] -gt $samples[$sampleNumber - 1] -and 
        # the next sample,
        $samples[$sampleNumber] -gt $samples[$sampleNumber + 1]
    ) {
        # it is a peak.

        # Output that peak as a vector of our start time and sample
        [Numerics.Vector2]::new(
            $sampleNumber,
            $samples[$sampleNumber]
        )
    }
}
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>PeakTrough</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Peaks and Troughs    
.DESCRIPTION
    Gets the points in a wave that are peaks or troughs.
#&gt;
[double[]]$samples = $this.Samples
for ($sampleNumber = 1 ; $sampleNumber -lt ($samples.Length - 1); $sampleNumber++) {

    $isPeak = 
        $samples[$sampleNumber] -gt $samples[$sampleNumber - 1] -and 
        $samples[$sampleNumber] -gt $samples[$sampleNumber + 1]

    if ($isPeak) {
        [Numerics.Vector2]::new($sampleNumber, $samples[$sampleNumber])
        
        continue
    }
    
    $isThrough =
        $samples[$sampleNumber] -lt $samples[$sampleNumber - 1] -and 
        $samples[$sampleNumber] -lt $samples[$sampleNumber + 1]        

    if ($isThrough) {
        [Numerics.Vector2]::new($sampleNumber, $samples[$sampleNumber])
        continue
    }         
}
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>SampleRate</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Sample Rate
.DESCRIPTION
    Gets the Sample Rate used for the Wave.

    This is the number of audio samples per second
.NOTES
    This is bytes 4 to 7 in the Format `fmt ` chunk (`4..7`)

    Mathematically speaking, we can have a negative sample rate, or a fractional sample rate.

    The `.wav` standard specifies the length in four bytes.
    
    Those bytes are expected to be a `[uint32]`.

    Many players will not play wave files below a 4400hz rate.
#&gt;

# The expected range
$range = 4..7
# If we have no cached format
if (-not $this.'#fmt') {
    # read chunks.
    $null = $this.Chunk
    # Return if we still have no cached format
    if (-not $this.'#fmt') { return }
}

# Otherwise, convert the range into a [uint32]
[bitConverter]::ToUint32($this.'#fmt'[$range] -as [byte[]], 0)


                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Samples</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Data
.DESCRIPTION
    Gets the byte[] describing a wave.
#&gt;
[CmdletBinding()]
param()

# If we have not cached our data chunk
if (-not $this.'#data') {
    # read chunks
    $null = $this.Chunk
    # If there is still nothing
    if (-not $this.'#data') {
        return # return nothing.
    }
}

if ($this.'#samples') {
    return $this.'#samples'
}

$bitsPerSample = $this.BitsPerSample
if (-not $bitsPerSample) { $bitsPerSample = 8}
$audioFormat = $this.AudioFormat
if (-not $audioFormat) { $audioFormat = 1 }
[byte[]]$PCM = $this.'#data'
[double[]]$Samples =
    if ($audioFormat -eq 3) {
        [Wave.WaveLinq]::DecodeFloat($PCM)
    } elseif ($audioFormat -eq 1) {
        if ($bitsPerSample -eq 8) {
            [Wave.WaveLinq]::DecodeByte($PCM)
        }
        elseif ($bitsPerSample -eq 16) {
            [Wave.WaveLinq]::DecodeInt16($PCM)
        }
        elseif ($bitsPerSample -eq 32) {            
            [Wave.WaveLinq]::DecodeInt32($PCM)
        }
    }

$this | Add-Member NoteProperty '#samples' $samples -Force
# Use the comma operator to return a list containin the data, 
# so that it unrolls to the data itself (rather than tries to stream the bytes)
return ,$this.'#samples'

                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets Wave Samples
.DESCRIPTION
    Sets the samples in the Wave.

    This changes the wave.
#&gt;
param(
# The new samples
[double[]]
$Samples
)

$BitsPerSample = 
    if ($this.BitsPerSample) { $this.BitsPerSample } 
    else { 32 }

$audioFormat = 
    if ($this.AudioFormat) { $this.AudioFormat } 
    else { 3 }

[byte[]]$NewData = @(
    if ($audioFormat -eq 1) {
        switch ($BitsPerSample) {
            8 {[Wave.WaveLinq]::EncodeByte($samples)}
            16 {[Wave.WaveLinq]::EncodeInt16($samples)}
            32 {[Wave.WaveLinq]::EncodeInt32($samples)}
        }
    }
    elseif ($audioFormat -eq 3) {
        [Wave.WaveLinq]::EncodeFloat($samples)
    }       
)

# Set our new data
$This.Data = $newData
# This will invalidate our samples, 
# so cache the sample data we just passed.
$this | 
    Add-Member NoteProperty '#Samples' $samples -Force

return $this


                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>SHA256</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets a Wave's Hash
.DESCRIPTION
    Gets the SHA256 hash of a wave.
#&gt;
[BitConverter]::ToString(
    [Security.Cryptography.SHA256]::Create().ComputeHash($this)
) -replace '-'
$null = $this.Seek('0', 'Begin')
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Software</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave's Software 
.DESCRIPTION
    Gets the Software of the wave.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    Software (or Name) metadata is stored
    with the four letter word key: `ISFT`
#&gt;

return $this.metadata.Software

                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets the Wave's Software
.DESCRIPTION
    Sets the Wave's Software metadata.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    Software metadata is stored
    with the four letter word key: `ISFT`

    The software is usually the software that last changed the wave.

    When files are saved, this field should be set to:
    
    `Wave $Version https://github.com/PoshWeb/Wave`
#&gt;
param([int]$Software)

$metadata = $this.metadata
$metadata.Software = "$Software"
$this.Metadata = $metadata

                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>SystemSound</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets System Sounds
.DESCRIPTION
    Gets System Sounds.
    
    Returns files on MacOS and Linux, and Registry Keys on Windows.
.NOTES
    |Operating System|Sound Location|
    |-|-|
    |Linux|`/usr/share/sounds`|
    |MacOS|`/System/Library/Components/CoreAudio.component/Contents/SharedSupport/SystemSounds/`|
    |Windows|`HKCU:\AppEvents\Schemes\Apps`|
#&gt;
if ($IsMacOS) {
    Get-ChildItem "/System/Library/Components/CoreAudio.component/Contents/SharedSupport/SystemSounds/" -Recurse -File
}
elseif ($IsLinux) {
    Get-ChildItem "/usr/share/sounds" -Recurse -File
}
else {
    Get-ChildItem -Path HKCU:\AppEvents\Schemes\Apps -Recurse   
}
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>TimeBase</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave Time Base
.DESCRIPTION
    Gets the Wave Time Base.  
    
    This is the smallest amount of time that the wave records.
.NOTES
    Since the sample rate is the number of samples per second, 
    
    This is the reciprocal of that value, expressed as a `[TimeSpan]`
#&gt;
param()

$sampleRate = $this.SampleRate

if (-not $sampleRate) { return [TimeSpan]::FromSeconds(0) }

if ($sampleRate) {
    [TimeSpan]::FromSeconds(
        (1 / $this.SampleRate)
    )
}
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Title</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave's title 
.DESCRIPTION
    Gets the title of the wave.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    Title (or Name) metadata is stored
    with the four letter word key: `INAM`
#&gt;

return $this.metadata.Title

                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets the Wave's Title
.DESCRIPTION
    Sets the Wave's title metadata.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    Title (or Name) metadata is stored
    with the four letter word key: `INAM`
#&gt;
param([string]$Title)

$metadata = $this.metadata
$metadata.Title = $Title
$this.Metadata = $metadata

                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>TrackNumber</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave's TrackNumber 
.DESCRIPTION
    Gets the Wave TrackNumber metadata.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    TrackNumber (or Part Number) metadata is stored
    with the four letter word key: `IPRT`
#&gt;

return $this.metadata.TrackNumber -as [int]

                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets the Wave's TrackNumber
.DESCRIPTION
    Sets the Wave's TrackNumber metadata.
.NOTES
    Wave Metadata is stored in an optional `LIST` chunk.

    TrackNumber (or Part Number) metadata is stored
    with the four letter word key: `IPRT`
#&gt;
param([int]$TrackNumber)

$metadata = $this.metadata
$metadata.TrackNumber = "$TrackNumber"
$this.Metadata = $metadata

                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Trough</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Troughs
.DESCRIPTION
    Gets the points in the wave that are troughs.
.OUTPUTS
    Outputs a `[Numerics.Vector2]` where the X is the sample number and the Y is the sample. 
#&gt;
param()
[double[]]$samples = $this.Samples
for ($sampleNumber = 1 ; $sampleNumber -lt ($samples.Length - 1); $sampleNumber++) {
    # If the sample
    if (        
        # is less than the previous sample
        $samples[$sampleNumber] -lt $samples[$sampleNumber - 1] -and 
        # and the next sample
        $samples[$sampleNumber] -lt $samples[$sampleNumber + 1]
    ) {
        # it is a trough.

        # Output a vector to the trough.
        # X is the sample number (time).
        # Y is the sample.
        [Numerics.Vector2]::new($sampleNumber, $samples[$sampleNumber])        
    }
}
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Vector2</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Vector
.DESCRIPTION
    Gets a Wave as a series of Vectors.

    We can think of a wave as a series of vectors.

    Each sample in the wave travels one distance along the X axis, 
    and up or down along the along the Y axis.
.NOTES
    Thinking of waves this way provides some benefits.

    This will write progress as it calculates and 
    cache the vectors in memory after they are calculated.
#&gt;
[OutputType([Numerics.Vector2[]])]
param()

if ($this.'#Vector2') { return ,$this.'#Vector2' }

[double[]]$Samples = $this.Samples

[Numerics.Vector2[]]$vector2 = [Wave.WaveLinq]::ToVector2($samples)

if ($vector2) {
    $this | Add-Member NoteProperty '#Vector2' $vector2 -Force
    return ,$vector2
}
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Vector3</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Vector
.DESCRIPTION
    Gets a Wave as a series of Vectors.

    We can think of a wave as a series of vectors.

    Each sample in the wave travels one distance along the X axis, 
    and up or down along the along the Y axis.

    We can also think of the length of the line between 
    X and Y as the depth (Z) of the wave, 
    and thus view each Wave as a series of 3D vectors.
.NOTES
    Thinking of waves this way provides some benefits.

    This will write progress as it calculates and 
    cache the vectors in memory after they are calculated.
#&gt;
if ($this.'#Vector3') { return $this.'#Vector3' }
[double[]]$Samples = $this.Samples
$lastSample = 0

$progress = [Ordered]@{
    Id = Get-Random    
    Activity = "Vectoring"    
}
$sampleRate = $this.SampleRate
$SampleCount = $samples.Length

[Numerics.Vector3[]]$vector3 = @(
    for ($index = 0; $index -lt $samples.Length;$index++) {
        $delta = $samples[$index] - $lastSample
        $length = [Math]::Sqrt(($delta * $delta) + 1)        

        if (-not ($index % 64kb)) {
            $progress.Status = "$index / $($SampleCount)"
            $progress.PercentComplete = ($index * 100 / $SampleCount)
            $progress.SecondsRemaining = (($SampleCount - $index) * (1 / $SampleRate))
            Write-Progress @progress
        }
        
        [Numerics.Vector3]::new(1, $delta, $(
            $length * $(
                if ($delta -gt 0) { 1 }
                elseif ($delta -lt 0) { -1 }
                else { 0 }    
            )
        ))                
        
        $lastSample = $samples[$index]
    }
)

$this | Add-Member NoteProperty '#Vector3' $vector3 -Force

return $vector3
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Volume</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Volume
.DESCRIPTION
    Gets a custom volume to apply to a wave.

    This is used to provide a default value for Wave methods that use `-Volume`.

    If no value has been set, will return zero.
#&gt;
param()
if ($this.'#Volume') { return $this.'#Volume' }
return 0
                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets Volume
.DESCRIPTION
    Sets a common volume used to generate the wave.
#&gt;
param(
# The volume
[double]
$Volume = (1/([Math]::PI * 2))
)

$this | 
    Add-Member NoteProperty '#Volume' $Volume -Force
return

                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>WaveFormat</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets Wave Format
.DESCRIPTION
    Gets the Wave Format as a dictionary
.NOTES
    This simplifies the construction of a new wave in the same format.
.EXAMPLE
    $wav = wave -AudioFormat 3 
    $waveFormat = $wav.WaveFormat
    $wave2 = wave @waveFormat    
#&gt;
$waveFormat = [Ordered]@{} 

# The expected range is 0,1 (first two bytes)
$range = 0,1
# If we have no cached format
if (-not $this.'#fmt') {
    # read chunks.
    $null = $this.Chunk
    # Return if we still have no cached format
    if (-not $this.'#fmt') { return }
}

$waveFormat['AudioFormat'] = [BitConverter]::ToUInt16($this.'#fmt', 0)
$waveFormat['ChannelCount'] = [BitConverter]::ToUInt16($this.'#fmt', 2)
$waveFormat['SampleRate'] = [BitConverter]::ToUInt32($this.'#fmt', 4)
$waveFormat['BytesPerSecond'] = [BitConverter]::ToUInt32($this.'#fmt', 8)
$waveFormat['BytesPerBlock'] = [BitConverter]::ToUInt16($this.'#fmt', 12)
$waveFormat['BitsPerSample'] = [BitConverter]::ToUInt16($this.'#fmt', 14)

return $waveFormat
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>WaveLength</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave Length
.DESCRIPTION
    Gets the length of the Wave.  
    
    This should be the length of the stream.
#&gt;
$this.Position = 4
[IO.BinaryReader]::new($this).ReadUInt32() + 8
                    </GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>Weights</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the weights on a wave
.DESCRIPTION
    When we play more than one frequency at a time,
    we can apply a weight to volume of each frequency.

    By default, each additional frequency will 
    have half of the weight of the previous frequency.

    Setting a custom set of weights allows us to change this default,
    and play different frequencies with different weights.        
.NOTES
    By default, each additional frequency will 
    have half of the weight of the previous frequency.

    Providing null or zero arguments will set the weight to one.
#&gt;

if ($this.'#Weights') {
    return ,$this.'#Weights'
} else {
    return ,[double[]]@(1)
}


                    </GetScriptBlock>
        <SetScriptBlock>
                        &lt;#
.SYNOPSIS
    Sets the weights on a wave
.DESCRIPTION
    When we play more than one frequency at a time,
    we can apply a weight to volume of each frequency.

    By default, each additional frequency will 
    have half of the weight of the previous frequency.

    Setting a custom set of weights allows us to change this default,
    and play different frequencies with different weights.        
.NOTES
    By default, each additional frequency will 
    have half of the weight of the previous frequency.

    Providing null or zero arguments will set the weight to one.
#&gt;
param([double[]]$Weights)

if ($weights) {
    $this | Add-Member NoteProperty '#Weights' $weights -Force
} else {
    $this | Add-Member NoteProperty '#Weights' ([double[]]1) -Force
}



                    </SetScriptBlock>
      </ScriptProperty>
      <NoteProperty>
        <Name>DefaultDisplay</Name>
        <Value>Channels
SampleRate
BitsPerSample
Duration</Value>
      </NoteProperty>
    </Members>
  </Type>
  <Type>
    <Name>WaveLinq</Name>
    <Members>
      <ScriptMethod>
        <Name>Arithmetic.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq Arithmetic
.DESCRIPTION
    Generates Wave Linq Arithmetic methods.

    These provide fast arithmetic operations on a large number of samples.
.NOTES
    Generates `Add`, `Subtract`, `Multiply`, and `Divide`

    These four operations differ by one character,
    and are generated in a small loop.
#&gt;

param()

foreach ($method in 'Add','Subtract','Multiply', 'Divide') {
    $operator = 
        switch ($method) {
            Multiply { '*' }
            Divide { '/' }
            Subtract { '-' }
            Add { '+' }
        }
    "
    /// &lt;summary&gt;
    /// ${method}s two sets of numbers and returns the result.
    /// &lt;/summary&gt;
    /// &lt;param name='numbers'&gt;The first set of numbers&lt;/param&gt;
    /// &lt;param name='operand'&gt;The second of numbers&lt;/param&gt;
    /// &lt;returns&gt;The $method of each number.&lt;/returns&gt;    
    public static IEnumerable&lt;double&gt; $method (
        this IEnumerable&lt;double&gt; numbers, 
        double[] operand
    ) {
        int n = 0;
        foreach (double number in numbers) {
            double modify = operand[n % operand.Length];
            n++;
            yield return number $operator modify;
        }
        yield break;
    }
    "
}

"
/// &lt;summary&gt;
/// Averages two sets of numbers and returns the result.
/// &lt;/summary&gt;
/// &lt;param name='numbers'&gt;The first set of numbers&lt;/param&gt;
/// &lt;param name='operand'&gt;The second of numbers&lt;/param&gt;
/// &lt;returns&gt;The $method of each pair of numbers&lt;/returns&gt;    
public static IEnumerable&lt;double&gt; Average (
    this IEnumerable&lt;double&gt; numbers, 
    double[] operand
) {
    int n = 0;
    foreach (double number in numbers) {
        double modify = (number + operand[n % operand.Length])/2;
        n++;
        yield return modify;
    }
    yield break;
}
"
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Calculus.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    WaveLinq Calculus
.DESCRIPTION
    Generates calculus extension methods.

    * `Delta`
    * `Angle`
    * `AreaUnderCurve`
#&gt;
@"



        public static IEnumerable&lt;double&gt; Delta(this IEnumerable&lt;double&gt; numbers) {
            double last = 0;
            foreach (double number in numbers) {
                double delta = number - last;
                last = number;
                yield return delta;
            }
            yield break;
        }

        public static IEnumerable&lt;double&gt; Angle(this IEnumerable&lt;double&gt; numbers) {
            double last = 0;
            foreach (double number in numbers) {
                double delta = number - last;
                last = number;
                yield return Math.Atan2(1, delta);
            }
            yield break;
        }

        public static IEnumerable&lt;double&gt; AreaUnderCurve(this IEnumerable&lt;double&gt; numbers) {
            double last = 0;
            foreach (double number in numbers) {
                double delta = number - last;
                last = number;

                // We can determine the area under the curve by imagining
                // our space between the samples as a rectangle and a right trangle

                double area = 0;
                
                // The number is the height of our rectangle
                // it's width is always one, since each sample has an X of 1.

                area += number;

                // The delta is the height of our triangle
                // it's width is also always one, since each sample has an X of 1.
                // We need to account for direction

                double direction = 1;
                if (delta != 0) {
                    direction = delta/Math.Abs(delta);
                }

                area += (1 * delta)/2.0 * direction;

                yield return area;
            }
            yield break;
        }
        
"@
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Decode.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq Decoders 
.DESCRIPTION
    Generates the source for WaveLinq Decoders.

    * `DecodeByte` (fixed 8-bit audio)
    * `DecodateInt16` (fixed 16-bit audio)
    * `DecodateInt32` (fixed 32-bit audio)
    * `DecodeFloat` (floating point 32-bit audio)
#&gt;
param()
@"
    public static IEnumerable&lt;double&gt; DecodeByte (
        this byte[] samples
    ) {
        if (samples == null) { yield break; }
        foreach (byte sample in samples) {
            yield return ( ((double)sample)/255.0 ) - 0.5;
        }
        
        yield break;        
    }

    public static IEnumerable&lt;double&gt; DecodeInt16 (
        this byte[] samples
    ) {
        if (samples == null) { yield break; }
        for (int n = 0; n &lt; samples.Length; n += 2) {
            Int16 iSample = BitConverter.ToInt16(samples, n);
            yield return ((double)iSample/Int16.MaxValue);
        }        
        
        yield break;        
    }

    public static IEnumerable&lt;double&gt; DecodeInt32 (
        this byte[] samples
    ) {
        if (samples == null) { yield break; }
        for (int n = 0; n &lt; samples.Length; n += 4) {
            Int32 iSample = BitConverter.ToInt32(samples, n);
            yield return ((double)iSample/Int32.MaxValue);
        }        
        
        yield break;        
    }

    public static IEnumerable&lt;double&gt; DecodeFloat (
        this byte[] samples
    ) {
        if (samples == null) { yield break; }
        for (int n = 0; n &lt; samples.Length; n += 4) {
            float iSample = BitConverter.ToSingle(samples, n);
            yield return ((double)iSample);
        }        
        
        yield break;        
    }
"@

                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Encode.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq Encoders
.DESCRIPTION
    Generates the source code for encoding Waves.
.NOTES
    Each Wave encoding varies mildly in how it iterates over samples.

    Approaching this problem with a bit of metaprogramming saves us
    from repeating ourselves.
#&gt;
$encoders = [Ordered]@{
    Byte = '(byte)Math.Floor(127 + s * 127)'
    Int16 = 'BitConverter.GetBytes((Int16)Math.Round(sample * Int16.MaxValue))'
    Int32 = 'BitConverter.GetBytes((Int32)Math.Round(sample * Int32.MaxValue))'
    Float = 'BitConverter.GetBytes((float)sample)'
}

foreach ($encoder in $encoders.Keys) {
@"
    public static IEnumerable&lt;byte&gt; Encode$Encoder (
        this IEnumerable&lt;double&gt; samples
    ) {
        if (samples == null) { yield break; }
        foreach (double sample in samples) {
            double s = sample;$(
            if ($encoder -ne 'Float') {
            "
            if (s &gt; 1) { s = 1; }
            if (s &lt; -1) { s = -1; }
            "
            }
            )
            $(
            if ($encoder -eq 'Byte') {
                "yield return $($encoders[$encoder]);"
            } else {
                "
                byte[] bytes = $($encoders[$encoder]);
                foreach (byte encoded in bytes) {
                    yield return encoded;
                }
                "
            }
            )            

        }
        yield break;        
    }
"@

}
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Envelope.cs</Name>
        <Script>
                        $envelopes = [Ordered]@{
    "Attack" = "n / total"    
    "FadeIn" = "n / total"
    "FadeOut" = "1.0 - (n/total)"    
    "Decay" = "1.0 - (n/total/2)"
    "Sustain" = "0.5"
    "Release" = "0.5 - (n/total/2)"
    "SinFadeIn" = "Math.Sin(n/total * (Math.PI/2))"
    "SinFadeOut" = "Math.Sin((1.0 - (n/total)) * (Math.PI/2))"
    "SinhFadeIn" = "Math.Sinh(n/total * (Math.PI/4))"
    "SinhFadeOut" = "Math.Sinh((1.0 - (n/total)) * (Math.PI/4))"    
}

foreach ($envelope in $envelopes.Keys) {
@"
    public static IEnumerable&lt;double&gt; $envelope (
        this int Length
    ) {
        if (Length == 0) { yield break; }
        double sign = Math.Abs(Length)/Length;
        double total = Math.Abs(Length);
        for (double n = 0; n &lt; total; n++) {
            yield return (
                $($envelopes[$envelope])
            ) * sign;
        }        
    }

    public static IEnumerable&lt;double&gt; $envelope(
        this double frequency,
        double sampleRate = 44100.0
    ) {
        double step = sampleRate/frequency;
        double sign = Math.Abs(step)/step;
        
        double total = Math.Abs(step);
        for (double n = 0; n &lt; total; n++) {
            yield return (
                $($envelopes[$envelope])
            ) * sign;
        }
    }

    public static IEnumerable&lt;double&gt; $envelope(
        this List&lt;double&gt; samples,
        double volume = (1 / (Math.PI * 2))
    ) {
        double n = 0;        
        double total = (double)samples.Count;
        
        foreach (double sample in samples) {
            yield return sample * ($((
                $($envelopes[$envelope])
            ))) * volume;
            n++;
        }
    }
"@
}



@"
    public static IEnumerable&lt;double&gt; Envelope(
        this List&lt;double&gt; samples,
        List&lt;double&gt; envelope = null,
        double volume = (1 / (Math.PI * 2))
    ) {
        if (envelope == null) {
            envelope = new List&lt;double&gt;();
            envelope.AddRange(FadeOut(samples.Count));
        }
        int n = 0;
        foreach (double sample in samples) {
            yield return sample * envelope[n % envelope.Count] * volume;
            n++;
        }        
    }

"@
return 
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Frequency.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Frequency Methods
.DESCRIPTION
    Generates Frequency Methods.
    
    We transform frequencies often in fairly predictable ways.

    This generates the WaveLinq methods for common frequency operations, including:

    * `ToCycle`
    * `FromCycle`
    * `ToMidi`
    * `FromMidi`
    * `Sharpen`
    * `Flatten`    
#&gt;

$Conversions = [Ordered]@{
    'ToMidi' = '69.0 + 12.0 * Math.Log(frequency / 440.0, 2)'
    'FromMidi' = '440.0 * Math.Pow(2, (frequency - 69.0) / 12 )'
}

$Movements = [Ordered]@{
    'Sharpen' = 'frequency / Math.Pow(2, (distance * -1.0) / 12)'
    'Flatten' = 'frequency * Math.Pow(2, (distance * -1.0) / 12)'
}

foreach ($conversion in $conversions.Keys) {
@"
        public static IEnumerable&lt;double&gt; $($conversion)(this IEnumerable&lt;double&gt; frequencies) {
            foreach (double frequency in frequencies) {
                yield return $($conversions[$conversion]);
            }
        }
"@
}

foreach ($movement in $movements.Keys) {
@"
        public static IEnumerable&lt;double&gt; $($movement)(this IEnumerable&lt;double&gt; frequencies, IEnumerable&lt;double&gt; distances) {
            foreach (double frequency in frequencies) {
                foreach (double distance in distances) {
                    yield return $($movements[$movement]);
                }
            }
        }
"@
}

@"
        public static IEnumerable&lt;double&gt; ToCycle(this IEnumerable&lt;double&gt; frequencies, IEnumerable&lt;double&gt; cycles) {
            foreach (double frequency in frequencies) {
                foreach (double cycle in cycles) {
                    yield return (Math.PI * 2 * frequency / cycle);
                }
            }
        }

        public static IEnumerable&lt;double&gt; FromCycle(this IEnumerable&lt;double&gt; frequencies, IEnumerable&lt;double&gt; cycles) {
            foreach (double frequency in frequencies) {
                foreach (double cycle in cycles) {
                    yield return (frequency * cycle) / (Math.PI * 2);
                }
            }
        }
"@
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Geometry.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    WaveLinq Geometry
.DESCRIPTION
    Generates the Geometric calculations in WaveLinq

    Includes:

    * Circumference
    * CircleArea
    * SquareArea/Squared
    * CubeVolume/Cubed
    * CubeSurfaceArea
    * SphereVolume
    * SphereSurfaceArea  
    * Radians
    * Degrees

    Each operation applies to an enumerable of numbers.
#&gt;

$Formulas = [Ordered]@{
    Circumference = 'Math.PI * 2 * n'
    
    CircleArea = 'Math.PI * n * n'    
    SquareArea = 'n * n'
    Squared = 'n * n'

    CubeVolume = 'n * n'
    Cubed = 'n * n * n'
    CubeSurfaceArea = '6.0 * n * n'
    
    SphereVolume = '4.0/3.0 * Math.PI * n * n * n'
    SphereSurfaceArea = '4.0 * Math.PI * n * n'
            
    Radians = 'n * (Math.PI / 180)'
    Degrees = 'n * (180 / Math.PI)'
}


foreach ($formula in $formulas.Keys) {
@"

    /// &lt;summary&gt;
    /// $formula
    /// &lt;/summary&gt;
    /// &lt;param name='numbers'&gt;A collection of numbers&lt;/param&gt;
    /// &lt;returns&gt;The $formula for each number&lt;/returns&gt;    
    public static IEnumerable&lt;double&gt; $Formula(this IEnumerable&lt;double&gt; numbers) {
        foreach (double n in numbers) {
            yield return $($Formulas[$formula]);
        }
        yield break;
    }
"@

}
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Trigonometry.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq Trigonometry
.DESCRIPTION
    Generates the Wave Linq methods for Trigonometry.
.NOTES
    Each of these methods simply yields a stream of each `Math.$method`
.EXAMPLE
    [Wave.WaveLinq]::Sin([double[]](1..100))
#&gt;

param()


$trigMethods = @(
    # The three base trigonmetric methods    
    'Sin', 'Cos', 'Tan',
    # and their arc equivalents.
    'Asin', 'Acos', 'Atan'
)

# Each trig methods has a hyperbolic function as well, ending with an `h`
$trigMethods += @( $trigMethods -replace '$', 'h')

# Walk over each alphabetized method
foreach ($method in $trigMethods | Sort-Object) {
    "
    /// &lt;summary&gt;
    /// Computes the Math.${method} of a sets of numbers.
    /// &lt;/summary&gt;
    /// &lt;param name='numbers'&gt;The set of numbers&lt;/param&gt;
    /// &lt;returns&gt;The $method of each number.&lt;/returns&gt;
    public static IEnumerable&lt;double&gt; $method (this IEnumerable&lt;double&gt; numbers) {
        foreach (double number in numbers) {
            yield return Math.$method(number);
        }
        yield break;
    }
    "
}
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Vector.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq Vectoring
.DESCRIPTION
    Generates Wave Linq Vector methods.

    These provide fast vector operations on a large number of samples.
.NOTES
    
#&gt;

param()

$Vectors = @{
    2 = 'Vector2 vector = new Vector2((float)c, (float)(sample - lastSample));'
    3 = '
            double length = Math.Sqrt(
                (delta * delta) + 1
            );

            double direction = length/Math.Abs(length);
            
            Vector3 vector = new Vector3(
                (float)c,
                (float)delta,
                (float)(length * direction)
            );
    '
}


foreach ($d in 2,3) {
@"    
    public static IEnumerable&lt;Vector$d&gt; ToVector$d(
        this IEnumerable&lt;double&gt; samples
    ) {
        double lastSample = 0;
        double c = 0;
        foreach (double sample in samples) {
            double delta = sample - lastSample;
            $($Vectors[$d])
            c++;
            lastSample = sample;
            yield return vector;
        }

        yield break;
    }
"@

}

return
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>WaveForm.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq WaveForms
.DESCRIPTION
    Generates the code for each Wave Linq Waveform.
.NOTES
    Each waveform has four overloads:

    * SimpleMonophonic ([double]frequency, [double]time, [double]weight, [uint32]sampleRate)
    * MonophonicSweep ([double[]]frequency, [double]time, [double]weight, [uint32]sampleRate)
    * SimplePolyphonic ([double]time, [double[]]frequency, [double[]]weight, [uint32]sampleRate)
    * ComplexPolyphonic ([double[]]time, [double[]]frequency, [double[]]weight)
#&gt;

param()

@"
    /// &lt;summary&gt;
    /// Sweep generator.  At a small enough timeframe, everything is a sweep.
    /// &lt;/summary&gt;
    /// &lt;param name='frequency'&gt;
    /// A sequence of double[] representing the frequencies to sweep
    /// Each frequency is a single sample, or the Sin of the time.
    /// &lt;/param&gt;
    /// &lt;param name='phase'&gt;
    /// The offset from a pure sine wave.    
    /// &lt;/param&gt;
    /// &lt;returns&gt;
    /// An `IEnumerable&lt;double&gt;` of samples.
    /// This is the raw unattenuated waveform.
    /// &lt;/returns&gt;
    /// &lt;/exception&gt;
    public static IEnumerable&lt;double&gt; SweepWave (
        IEnumerable&lt;double&gt; frequency,
        double phase = 0
    ) {
        double c = phase;
        // For each sample we want to generate
        foreach (double freq in frequency) {
            // Yield our sample, letting iteration continue.
            yield return Math.Sin(c * freq);
            c++;
        }
        
        // When we have reached the end of our time
        // take a break.
        yield break;
    }
"@

$waveForms = [Ordered]@{
    "SineWave" = "
sample += Math.Sin(t * f) * w;
"
    "CosineWave" = "
sample += Math.Cos(t * f) * w;
"
    "TriangleWave" = "
sample += Math.Asin(Math.Sin(t * f)) * w;
"
    "CosineTriangleWave" = "
sample += Math.Acos(Math.Cos(t * f)) * w;
"
    "SawWave" = "
sample += Math.Atan(Math.Tan(t/2 * f)) * w;
"
    "CosineSawWave" = "
sample += Math.Atan(Math.Tan(t/2 * f)) * w * -1.0;
"
    "CosineSquareWave" = "
double sine = Math.Cos(t * f);
if (sine &gt; 0) {
    sample += 1.0 * w;
}
else if (sine &lt; 0) {
    sample += -1.0 * w;
}
"
    "SquareWave" = "
double sine = Math.Sin(t * f);
if (sine &gt; 0) {
    sample += 1.0 * w;
}
else if (sine &lt; 0) {
    sample += -1.0 * w;
}
"
    "CircleSquareWave" = "
double sine = Math.Sin(t * f);
if (sine &gt; 0) {
    sample += sine * w;
}
else if (sine &lt; 0) {
    sample += -1.0 * w;
}
"
    "SquareCircleWave" = "
double sine = Math.Sin(t * f);        
if (sine &gt; 0) {
    sample += 1.0 * w;
}
else if (sine &lt; 0) {
    sample += sine * w;
}
"
    "TriangleCircleWave" = "
double sine = Math.Sin(t * f);
if (sine &gt; 0) {
    sample += Math.Asin(sine) * w;
}
else if (sine &lt; 0) {
    sample += sine * w;
}
"
    "CircleTriangleWave" = "
double sine = Math.Sin(t * f);
if (sine &gt; 0) {
    sample += sine * w;
}
else if (sine &lt; 0) {
    sample += Math.Asin(sine) * w;
}
    "
}

&lt;#

For each of our waveforms we want to generate multiple overloads:

* A simple monophonic generator that generates a frequency over time
  * `[double]`frequency, `[double]`time, `[double]`weight, `[uint32]`sampleRate
* A sweeping monophonic generator that accepts a list of frequencies over time.
  * `[double]`time, `[double[]]`frequency, `[double[]]`weight, `[uint32]`sampleRate  
* A simple polyphonic generator that accepts a time, list frequencies, list of weights, and sample rate
  * `[double]time, [double[]]frequency, [double[]]weight, [uint32]sampleRate`
* A complex polyphonic generator that accepts a list of times, frequencies, and weights
  * `[double[]]time, [double[]]frequency, [double[]]weight`

Aside from the weight scale, each wave should be unattenuated.

It should be put into an appropriate envelope.

#&gt;
$methods = foreach ($waveType in $waveForms.Keys) {

    #region Simple Monophonic
@"
    /// &lt;summary&gt;
    /// ${wavetype} generator.
    /// &lt;/summary&gt;
    /// &lt;param name='frequency'&gt;
    /// A sequence of double[] representing the time.
    /// Each whole number should be a sample.&lt;/param&gt;
    /// &lt;param name='frequency'&gt;
    /// A sequence of frequencies.
    /// The combined wave is the sum of all frequencies.
    /// &lt;/param&gt;
    /// &lt;returns&gt;
    /// An `IEnumerable&lt;double&gt;` of samples.
    /// This is the raw unattenuated waveform.
    /// &lt;/returns&gt;        
    public static IEnumerable&lt;double&gt; $WaveType (
        this double frequency,
        double time = 60.0/128.0,
        double weight = 0.5,
        uint sampleRate = (uint)44100
    ) {
        int sampleCount = (int)Math.Round((time * (double)sampleRate));
        double f = (Math.PI * 2 * frequency)/sampleRate;
        double w = weight;
        for (int sampleNumber = 0; sampleNumber &lt; sampleCount;sampleNumber++) {
            double sample = 0;
            double t = (double)sampleNumber;
            $(
                $waveForms[$waveType] -split '(?&gt;\r\n|\n)' -ne '' -join "$(
                    ([Environment]::NewLine) +(' ' * 12)
                )"
            )
            yield return sample;
        }
        yield break;
    }
"@
    #endregion Simple Monophonic

    #region Sweeping Monophonic    
@"
    /// &lt;summary&gt;
    /// ${wavetype} generator.
    /// &lt;/summary&gt;
    /// &lt;param name='frequency'&gt;
    /// A sequence of double[] representing the time.
    /// Each whole number should be a sample.&lt;/param&gt;
    /// &lt;param name='time'&gt;
    /// The number of seconds to generate    
    /// &lt;/param&gt;
    /// &lt;param name='weight'&gt;
    /// The weight applied to each sample.  This scales the volume.    
    /// &lt;/param&gt;
    /// &lt;param name='sampleRate'&gt;
    /// The sample rate.
    /// Multi-channel audio has an effective sample rate of SampleRate*ChannelCount     
    /// &lt;/param&gt;
    /// &lt;returns&gt;
    /// An `IEnumerable&lt;double&gt;` of samples.
    /// This is the raw unattenuated waveform.
    /// &lt;/returns&gt;        
    public static IEnumerable&lt;double&gt; $WaveType (
        this List&lt;double&gt; frequency,
        double time = 60.0/128.0,
        double weight = 0.5,
        uint sampleRate = (uint)44100
    ) {
        if (frequency.Count == 0) { yield break; }
        if (frequency.Count == 1) {
            foreach (double sample in frequency[0].$WaveType(time,weight,sampleRate)) {
                yield return sample;
            }
            yield break;
        }

        int sampleCount = (int)Math.Round((double)time * (double)sampleRate);

        double w = weight;
        double frequencyStepLength = (double)sampleCount/(double)frequency.Count;
        for (int sampleNumber = 0; sampleNumber &lt; sampleCount;sampleNumber++) {
            double sample = 0;
            double t = (double)sampleNumber;
            double ft = (
                (double)sampleNumber/(double)sampleCount
            );
             
            double fromFrequency = frequency[(int)Math.Floor(ft * (frequency.Count - 1))];            
            double toFrequency =  frequency[(int)Math.Ceiling(ft * (frequency.Count - 1))];
            double momentFrequency = fromFrequency + (
                (toFrequency - fromFrequency) * ((ft * (frequency.Count - 1)) % 1)
            );
            double f = (Math.PI * 2 * momentFrequency)/sampleRate;
            $(
                $waveForms[$waveType] -split '(?&gt;\r\n|\n)' -ne '' -join "$(
                    ([Environment]::NewLine) +(' ' * 12)
                )"
            )
            yield return sample;
        }
        yield break;
    }
"@
    #endregion Sweeping Monophonic

    #region Simple Polyphonic
@"
    /// &lt;summary&gt;
    /// ${wavetype} generator.
    /// &lt;/summary&gt;
    /// &lt;param name='time'&gt;
    /// A sequence of double[] representing the time.
    /// Each whole number should be a sample.&lt;/param&gt;
    /// &lt;param name='frequency'&gt;
    /// A sequence of frequencies.
    /// The combined wave is the sum of all frequencies.
    /// &lt;/param&gt;
    /// &lt;returns&gt;
    /// An `IEnumerable&lt;double&gt;` of samples.
    /// This is the raw unattenuated waveform.
    /// &lt;/returns&gt;    
    /// &lt;/exception&gt;
    public static IEnumerable&lt;double&gt; $WaveType (
        this double time,
        IEnumerable&lt;double&gt; frequency,
        double[] weight = null,
        uint sampleRate = (uint)44100
    ) {
        int sampleCount = (int)Math.Round((time * (double)sampleRate));
        if (weight == null) {
            weight = new double[1];
            weight[0] = 1;            
        }
        // If the weight is zero, make it 1
        if (weight.Length == 1 &amp;&amp; weight[0] == 0) {
            weight[0] = 1;
        }
        for (int sampleNumber = 0; sampleNumber &lt; sampleCount;sampleNumber++) {
            double t = (double)sampleNumber;        
            // If the frequency was null, return silence
            if (frequency == null) {
                yield return 0.0;
            } else {
                // Otherwise, we want to sum multiple waveforms
                // so start our frequency count at zero
                int freqNumber = 0;
                // and our sample at 0.0
                double sample = 0.0;                
                // Then set the weight to the first item in the list.
                double w = weight[0];
                // Then generate the wave for each frequency 
                foreach (double freq in frequency) {
                    double f = (freq * Math.PI * 2)/(double)sampleRate; 
                    // adding each of our outputs to the sample.
                    $(
                        $waveForms[$waveType] -split '(?&gt;\r\n|\n)' -ne '' -join "$(
                            ([Environment]::NewLine) + (' ' * 20)
                        )"
                    )
                    // Move onto the next frequency
                    freqNumber++;
                    // If we have any more weights
                    if (freqNumber &lt; weight.Length) {
                        // Make the next frequency that weight.
                        w = weight[freqNumber];
                    } else {
                        // Otherwise, half the weight
                        w /= 2; 
                    }
                }
                // Yield our sample, letting iteration continue.
                yield return sample;
            }
        }
        
        // When we have reached the end of our time
        // take a break.        
        yield break;
    }
"@    
    #endregion Simple Polyphonic

    #region Complex Polyphonic
@"
    /// &lt;summary&gt;
    /// ${wavetype} generator.
    /// &lt;/summary&gt;
    /// &lt;param name='time'&gt;
    /// A sequence of double[] representing the time.
    /// Each whole number should be a sample.&lt;/param&gt;
    /// &lt;param name='frequency'&gt;
    /// A sequence of frequencies.
    /// The combined wave is the sum of all frequencies.
    /// &lt;/param&gt;
    /// &lt;returns&gt;
    /// An `IEnumerable&lt;double&gt;` of samples.
    /// This is the raw unattenuated waveform.
    /// &lt;/returns&gt;    
    /// &lt;/exception&gt;
    public static IEnumerable&lt;double&gt; $WaveType (
        IEnumerable&lt;double&gt; time,
        IEnumerable&lt;double&gt; frequency,
        double[] weight
    ) {
        // If there is no time, break
        if (time == null) { yield break; }
        // If there is no weight, break
        if (weight == null) {
            yield break;
        }
        // If the weight is zero, make it 1
        if (weight.Length == 1 &amp;&amp; weight[0] == 0) {
            weight[0] = 1;
        }
        // For each sample we want to generate
        foreach (double t in time) {
            // If the frequency was null, return silence
            if (frequency == null) {
                yield return 0.0;
            } else {
                // Otherwise, we want to sum multiple waveforms
                // so start our frequency count at zero
                int freqNumber = 0;
                // and our sample at 0.0
                double sample = 0.0;                
                // Then set the weight to the first item in the list.
                double w = weight[0];               
                // Then generate the wave for each frequency 
                foreach (double f in frequency) {
                    // adding each of our outputs to the sample.
                    $(
                        $waveForms[$waveType] -split '(?&gt;\r\n|\n)' -ne '' -join "$(
                            ([Environment]::NewLine) +(' ' * 20)
                        )"
                    )
                    // Move onto the next frequency
                    freqNumber++;
                    // If we have any more weights
                    if (freqNumber &lt; weight.Length) {
                        // Make the next frequency that weight.
                        w = weight[freqNumber];
                    } else {
                        // Otherwise, half the weight                        
                        w /= 2; 
                    }
                }
                // Yield our sample, letting iteration continue.
                yield return sample;
            }
        }
        
        // When we have reached the end of our time
        // take a break.        
        yield break;
    }
"@
    #endregion Complex Polyphonic    
}

$methods -join ([Environment]::NewLine * 2)
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>WaveOps.cs</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Linq Operations
.DESCRIPTION
    Generates the code for each common Wave Linq operation.
.NOTES

#&gt;

param()

foreach ($method in 'Add','Subtract', 'Multiply', 'Divide') {
    $operator = switch ($method) {
        'Add' { '+' }
        'Subtract' { '-' }
        'Multiply' { '*' }
        'Divide' { '/' }
    }    

@"
    /// &lt;summary&gt;
    /// ${method}s a set of numbers at a specific offset.
    /// &lt;/summary&gt;
    /// &lt;param name='current'&gt;The current set of samples&lt;/param&gt;
    /// &lt;param name='offset'&gt;The offset&lt;/param&gt;
    /// &lt;param name='samples'&gt;A list of samples to $Method&lt;/param&gt;
    /// &lt;returns&gt;The $method of each number.&lt;/returns&gt;
    public static IEnumerable&lt;double&gt; $Method(
        IList&lt;double&gt; current, 
        int offset,
        IList&lt;double&gt; samples   
    ) {
        int index = 0;
        if (current.Count &gt; offset) {
            for (index = 0; index &lt; offset; index++) {
                yield return current[index]; //get the samples until the offset
            }
        } else {
            // Otherwise, include the current samples
            foreach (double sample in current) {
                yield return sample;
            }
            
            // and pad the remainder of the time until start with silence
            int deltaSamples = offset - current.Count;
            for (int i = 0; i &lt; deltaSamples; i++) {
                yield return 0;
            }
        }
                    
        for (index = 0; index &lt; samples.Count; index++) {
            // If we are still within the current timeframe
            if (current.Count &gt; (index + offset)) {
                // Add samples in at that point
                yield return current[index + offset] $operator samples[index];
            } else {
                // Otherwise, simply include the new sample
                yield return samples[index]$( if ($operator -eq '-') { '* -1'});
            }
        }

        yield break;
    }
"@


}

@"
    /// &lt;summary&gt;
    /// Averages two waves at a specific offset.
    /// &lt;/summary&gt;
    /// &lt;param name='current'&gt;The current set of samples&lt;/param&gt;
    /// &lt;param name='offset'&gt;The offset&lt;/param&gt;
    /// &lt;param name='samples'&gt;A list of samples to average&lt;/param&gt;
    /// &lt;returns&gt;The average wave&lt;/returns&gt;
    public static IEnumerable&lt;double&gt; Average(
        IList&lt;double&gt; current, 
        int offset,
        IList&lt;double&gt; samples
    ) {
        int index = 0;
        if (current.Count &gt; offset) {
            for (index = 0; index &lt; offset; index++) {
                yield return current[index]; //get the samples until the offset
            }
        } else {
            // Otherwise, include the current samples
            foreach (double sample in current) {
                yield return sample;
            }
            
            // and pad the remainder of the time until start with silence
            int deltaSamples = offset - current.Count;
            for (int i = 0; i &lt; deltaSamples; i++) {
                yield return 0;
            }
        }
                    
        for (index = 0; index &lt; samples.Count; index++) {
            // If we are still within the current timeframe
            if (current.Count &gt; (index + offset)) {
                // Add samples in at that point
                yield return (current[index + offset] + samples[index])/2;
            } else {
                // Otherwise, simply include the new sample
                yield return samples[index];
            }
        }

        yield break;
    }
"@

@"

    /// &lt;summary&gt;
    /// Simplified Wave Gain.
    /// &lt;/summary&gt;
    /// &lt;param name='samples'&gt;The current set of samples&lt;/param&gt;
    /// &lt;param name='gain'&gt;The gain&lt;/param&gt;    
    /// &lt;returns&gt;The wave with a gain applied&lt;/returns&gt;
    public static IEnumerable&lt;double&gt; Gain(
        this IEnumerable&lt;double&gt; samples,
        double gain
    ) {
        if (gain &lt; 0) {
            gain = -1 / gain;
        }
        
        foreach (double sample in samples) {
            yield return sample * gain;
        }
    }
"@

@"
    /// &lt;summary&gt;
    /// Simplified Wave Sampler.
    /// &lt;/summary&gt;
    /// &lt;param name='samples'&gt;The current set of samples&lt;/param&gt;
    /// &lt;param name='start'&gt;The start sample&lt;/param&gt;    
    /// &lt;param name='start'&gt;The end sample&lt;/param&gt;    
    /// &lt;returns&gt;The wave with a gain applied&lt;/returns&gt;
    public static IEnumerable&lt;double&gt; Sample(
        this IList&lt;double&gt; samples,
        int start,
        int end
    ) {        
        if (start == end) { yield break; }
        if (start &lt; end) {
            for (int index = start; index &lt;= end ; index++) {
                if (samples.Count &gt; index) {
                    yield return samples[index];
                } else {
                    yield return 0; 
                }                
            }    
        } else {
            for (int index = end; index &gt;= start ; index--) {
                if (samples.Count &gt; index) {
                    yield return samples[index];
                } else {
                    yield return 0; 
                }
            }
        }
    }    
"@

                    </Script>
      </ScriptMethod>
      <ScriptProperty>
        <Name>TypeDefinition</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Wave Linq Type Definition
.DESCRIPTION
    Gets the Type Definition for Wave.WaveLinq.
.NOTES
    This uses a number of script methods to generate a C# class.

    This uses the "type coalescing" technique, 
    where a complete type is built by joining the output of 
    several dynamic script methods.

    This avoids repeating code and condenses the implementation.
.EXAMPLE
    Add-Type -TypeDefinition (
        [PSCustomObject]@{PSTypename='WaveLinq'}
    ).TypeDefinition -PassThru
#&gt;

$ClassDefinition = @(        
    $methods = 'Arithmetic',
        'Calculus', 
        'Geometry',
        'Trigonometry',
        'Encode', 
        'Decode', 
        'Envelope', 
        'Vector', 
        'Frequency', 
        'WaveForm',
        'WaveOps' -replace '$','.cs'
        
    foreach ($method in $methods) {
        if (-not $this.$method) { continue }
        "#region $($method -replace '\.cs$')"
        $this.$method.Invoke()        
        "#endregion $($method -replace '\.cs$')"
    }    
) -join ([Environment]::NewLine)

@"
namespace Wave {

    using System;    
    using System.Collections;
    using System.Collections.Generic;
    using System.Management.Automation;
    using System.Numerics;
    using System.IO;
    using System.Text;

    public static class WaveLinq$(
        if ($DebugPreference -notin 'ignore', 'silentlyContinue') {
            Get-Random
        }
    ) {
$ClassDefinition
    }
}
"@


                    </GetScriptBlock>
      </ScriptProperty>
    </Members>
  </Type>
</Types>