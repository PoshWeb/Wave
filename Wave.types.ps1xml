[float]
$Volume = 0.5
)

$this | 
    Add-Member NoteProperty '#Volume' $Volume -Force
return

                    </SetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>WaveLength</Name>
        <GetScriptBlock>
                        &lt;#
.SYNOPSIS
    Gets the Wave Length
.DESCRIPTION
    Gets the length of the Wave.  
    
    This should be the length of the stream.
