    This should be `$this.BitsPerSample/8` * `$this.ChannelCount`
.NOTES
    This is the second to last pair of bytes in the Format `fmt ` chunk (`12,13`)
#&gt;

# The expected range
$range = 12,13
# If we have no cached format
if (-not $this.'#fmt') {
    # read chunks.
    $null = $this.Chunk
