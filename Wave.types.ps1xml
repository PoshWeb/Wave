      <ScriptMethod>
        <Name>Add</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Adds Samples
.DESCRIPTION
    Adds Samples to a wave.

    If the wave has no samples, this will simply set the samples.

    If a wave has samples, this will add the samples to the wave, 
    mixing the audio together.
#&gt;
param(
# The other wave
$OtherWave,
# The start time for the addition
$Time = 0
)

# Collect our samples from the other wave
[double[]]$Samples = 
    # If the other wave is a `Wave`
    if ($otherWave.pstypenames -contains 'wave') {
        # get it's samples
        $otherWave.Samples
    }
    # If the other wave can be cast to a `[double[]]`
    elseif ($OtherWave -as [double[]]) 
    {
        # treat it as an array of samples
        $OtherWave -as [double[]]
    }

# Get our current samples
[double[]]$current = $this.Samples

# If we have no current samples
if (-not $current) {
    # Then we are just going to add to the samples to the end
    $this.Samples = $samples
    return $this
}

# If a start time was specified
if ($Time) {
    # it could be a `[TimeSpan]`
    if ($time -is [TimeSpan]) {        
        $time = $time.TotalSeconds
    }
    # Or a `[double]`
    else {
        $time = $time -as [double]
    } 
    # Either way, set the start to the time
    $start = $time
} 

# If we have not set a start,
if (-not $start) {
    $Start = 0 # initialize to zero
}

# Get the sample rate and channel count
$SampleRate = $this.SampleRate
$ChannelCount = $this.ChannelCount

# This can be used to compute an offset
$Offset = [Math]::Floor($start * $SampleRate * $ChannelCount)

$this.Samples = [double[]][Wave.WaveLinq]::Add(
    $current, 
    [int]$Offset,
    $Samples
)
return $this
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Bounce</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Bounce
.DESCRIPTION
    Generates a Wave that bounces between two frequencies.    
#&gt;
[OutputType('Wave')]
param(
# The frequency.
# If no frequency is provided, it will be 440hz (A4)
[Alias('Hz')]
$Frequency,

# The distance to bounce, in semitones  
[double]
$Distance = 12,

# The duration to generate.
[Timespan]$Duration = $(
    if ($this.BPM -is [TimeSpan]) {$this.BPM} 
    else { [TimeSpan]::FromSeconds(60/128) }
),

# The volume.
# If the current wave has set a `volume`, 
# will use that volume.
# Otherwise, will default to 1/([Math]::PI/2)
[double]$Volume = $(
    if ($this.Volume) { $this.Volume } else { 1/([Math]::PI * 2) }
),

# The sample rate.
# Will default to the `.SampleRate` of `$this` wave.
# If there is no `$this` wave, will default to 44100
[uint32]$SampleRate = $(
    if ($this.SampleRate) { $this.SampleRate } else { 44100 }
),

# The channel count.
# Will default to the `.ChannelCount` of `$this` wave.
# If there is no `$this` wave, will default to 1 (mono).
[uint16]$channelCount = $(
    if ($this.ChannelCount) { $this.ChannelCount } else { 1 }
)
)

$currentWave = $this
if (-not $currentWave) { $currentWave = wave }
if (-not $PSBoundParameters['Frequency']) { $Frequency = 440 }

$fromAngles = $currentWave.MeasureAngle($Frequency, $SampleRate, $channelCount)

$toAngles =
    foreach ($from in $fromAngles) {
        $from * [Math]::Pow(2, (($Distance * -1.0)/12))
    }

# Calculate the number of samples
$numberOfSamples = [Math]::Round(
    $Duration.TotalSeconds * $SampleRate * $channelCount
) 

$half = $numberOfSamples / 2

# Now let's make our samples
[double[]]$Samples = @(
    # Start $t at zero
    foreach ($t in 0..($numberOfSamples - 1)) {
        $ft = $t/$numberOfSamples
        #region Polysweep
        [double]$Sample = 0.0
        # Each successive angle will have a weighted volume
        # starting at full volume
        $angleWeight = 1.0
        # Take each of our angles and Add it Up
        $angles = @(
            $angleNumber = 0 
            foreach ($angle in $fromAngles) {
                $toAngle = $toAngles[$angleNumber]
                if ($t -lt $half) {                    
                    $angle + ($angle - $toAngle) * $ft/2                    
                } else {                    
                    $toAngle - ($toAngle - $angle) * $ft/4                    
                }                
                $angleNumber++
            }
        )

        foreach ($angle in $angles) {
            # Get the sine of the times and multiply by the weight.
            $Sample += [Math]::Sin($angle * $t) * $angleWeight
            # Then half the weight               
            $angleWeight/=2
        }
        #endregion Polysweep
        
        #region Envelope        
        $envelope = 1.0 - ($t / $numberOfSamples)                        
        $sample * $Volume * $envelope    
        #endregion Envelope
    }
)

# If we have not been provided a time
if (-not $time) {
    # add it to the end.
    $time = $currentWave.Duration
}

if ($Time) {
    return $currentWave.Add($samples, $time)
}
else {
    $waveFormat = $currentWave.WaveFormat
    if (-not $waveFormat) {
        $waveFormat = @{}
    }
    return wave @waveFormat -Samples $Samples
}
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Channel</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Wave Channels
.DESCRIPTION
    Isolates a single channel in an audio wave.
    
    Outputs a new wave with only that channel.
.NOTES
    The new wave will still be multi-channel audio,
    it will simply have silence on all other channels.
#&gt;
param(
# The number of the channel, or `left` or `right`.
# Defaults to channel 0 left.
$Channel = 0
)

if ($this.ChannelCount -eq 1) {
    Write-Warning "Audio is mono"
    return $this
}

# If the channel was `left` or `right`, make it the correct index
if ($Channel -eq 'left') { $channel = 0 }
elseif ($channel -eq 'right') { $channel = 1 }

# If the channel is not an integer at this point
if ($channel -isnot [int]) {
    # error out.
    Write-Error "Channel must be an integer, 'left', or 'right', not $channel"
    return
}

# Collect our samples
[double[]]$Samples = $this.Samples
# and determine our number of channels
$channelCount = $this.ChannelCount

# Walk over each sample
[double[]]$ChannelSamples = @(
    for ($index = 0; $index -lt $samples.Length;$index++) {
        # determine the channel number
        $channelNumber = $index % $channelCount
        # if it is the target channel,
        if ($channelNumber -eq $channel) {
            $samples[$index] # return it as is,
        } else { # otherwise,
            0 # inject silence.
        }
    }
)

# Duplicate our current wave format
$waveFormat = $this.WaveFormat
# and return a new wave with only the desired channel.
return wave @waveFormat -Samples $ChannelSamples

                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>Chirp</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Chirp Wave
.DESCRIPTION
    Chirp Wave generator.
    
    Generates a Wave that "chirps" between two frequencies.
.NOTES
    Chirps have an unusual envelope.
    
    They gets softer as it approaches the half, then louder as it approaches the end.

    This makes chirps a tricky sound to combine, 
    as they slighty "pop" if directly combined.

    This effect will be significantly less noticeable with
    rests in between each chirp.
#&gt;
[OutputType('Wave')]
param(
# The frequency
[Alias('Hz')]
$Frequency = 0,

# The distance to the end of the chirp, in semitones
[double]
$Distance = -12,

# The amount of time to generate.
[Timespan]$Duration = $(
    if ($this.BPM -is [TimeSpan]) {$this.BPM} 
    else { [TimeSpan]::FromSeconds(60/128) }
),

# The volume
[double]$Volume = $(
    if ($this.Volume) { $this.Volume }
    else { 1/([Math]::PI * 2) }
),

# The start time
$Time,

# The sample rate.
# Will default to the `.SampleRate` of `$this` wave.
# If there is no `$this` wave, will default to 44100
[uint32]$SampleRate = $(
    if ($this.SampleRate) { $this.SampleRate } else { 44100 }
),


# The channel count.
# Will default to the `.ChannelCount` of `$this` wave.
# If there is no `$this` wave, will default to 1 (mono).
[uint16]$channelCount = $(
    if ($this.ChannelCount) { $this.ChannelCount } else { 1 }
)
)

$currentWave = $this
if (-not $currentWave) { $currentWave = wave }
if (-not $PSBoundParameters['Frequency']) { $Frequency = 440 }

$fromAngles = $currentWave.MeasureAngle($Frequency, $SampleRate, $channelCount)

$toAngles = foreach ($from in $fromAngles) {
    $from * [Math]::Pow(2, (($Distance * -1.0)/12))    
}

# Calculate the number of samples
$numberOfSamples = [Math]::Round($Duration.TotalSeconds * $SampleRate * $channelCount)

$half = $numberOfSamples / 2
# Now let's make our samples
[double[]]$Samples = @(
    # Start $t at zero
    foreach ($t in 0..($numberOfSamples - 1)) {
        $ft = $t/$numberOfSamples
        #region Polysweep
        [double]$Sample = 0.0
        # Each successive angle will have a weighted volume
        # starting at full volume
        $angleWeight = 1.0
        # Take each of our angles and Add it Up
        $angles = @(
            $angleNumber = 0 
            foreach ($angle in $fromAngles) {
                $toAngle = $toAngles[$angleNumber]
                
                if ($t -lt $half) {     
                    $angle
                    # $angle + ($angle - $toAngle) * $ft/2
                } else {
                    $toAngle
                    # $toAngle - ($toAngle - $angle) * $ft/4
                }
                
                $angleNumber++
            }
        )

        foreach ($angle in $angles) {
            # Get the sine of the times and multiply by the weight.
            $Sample += [Math]::Sin($angle * $t) * $angleWeight
            # Then half the weight               
            $angleWeight/=2
        }
        #endregion Polysweep
        
        #region Envelope        
        $envelope = if ($t -lt $half) {
            1.0 - ($t / $half)
        } else {
            1.0 - ($t - $half) / ($numberOfSamples - $half)
        }        
        $sample * $Volume * $envelope
        #endregion Envelope
    }
)

# If we have not been provided a time
if (-not $time) {
    # add it to the end.
    $time = $currentWave.Duration
}

if ($Time) {
    return $currentWave.Add($samples, $time)
}
else {
    $waveFormat = $currentWave.WaveFormat
    if (-not $waveFormat) {
        $waveFormat = @{}
    }
    return wave @waveFormat -Samples $Samples
}
                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>CircleOfFiths</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Cirlce of Fifths Wave Generator
.DESCRIPTION
    Generates waves using the Circle of Fifths
.LINK
    https://en.wikipedia.org/wiki/Circle_of_fifths
.NOTES
#&gt;
param(
# The starting point along the circle of fifths
$Start = 0,

# The note count (by default, 13)
[int]
$NoteCount =  13,

# Play in octave 3 by default
[int]
$Octave = 3,

# The note timing
[Alias('bpm')]
[timespan]
$Duration = ([TimeSpan]::FromSeconds(60/128))
)

$noteSequence = 'C','G','D','A','E','B','F#', 'C#','A','E','B'

$currentWave = $this
if (-not $currentWave) {
    $currentWave = wave
}

if ($start -is [int]) {
    $startIndex = $start
}

if ($start -is [string]) {
    for ($startIndex = 0; $startIndex -lt $noteSequence.Length; $startIndex++) {
        if ($start -eq $noteSequence[$startIndex]) {
            break        
        }
    }
}
$noteFrequency = $currentWave.NoteFrequency
[Collections.IDictionary[]]$tune = 
    for ($index = $startIndex; $index -lt ($startIndex + $NoteCount); $index++) {
        
        $noteIndex =  $index % $noteSequence.Length
        
        $letterNote = $noteSequence[$noteIndex] -replace 
            '(?&lt;=\p{L})', $Octave -replace 
            '(?&lt;d&gt;\d)\#', '#${d}'
        
        [Ordered]@{
            Name = 'LetterNote'
            Letter = $letterNote
            Octave = $Octave
            Frequency = $noteFrequency[$letterNote -replace '#', '♯']
            Duration = $Duration
        }
    }
    
$currentWave.Melody += $tune
return $currentWave.Sound()

                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>CircleSquare</Name>
        <Script>
                        &lt;#
.SYNOPSIS
    Circle Square tone Generator
.DESCRIPTION
    Generates a circle / square tone of a `-Frequency`, for `-Time`, at `-Volume`
.NOTES
    A square wave is calculated by taking the sine of a given angle 
    and turning it into squares:

    ~~~PowerShell
    $sample = [Math]::Sin($t * $angle)
    $sample = 
        if ($sample -gt 0) { 1 }
        elseif ($sample -lt 0) { -1 }
        else { 0 }
    ~~~

    A Circle Square keeps the bottom half of the square, 
    and leaves the top half as a sine wave.
.LINK
    https://en.wikipedia.org/wiki/Square_wave_(waveform)
#&gt;
[OutputType('Wave')]
param(
# The frequency.
# Defaults to A4 (440hz)
[Alias('Hz')]
$Frequency = 440.0,

# The amount of time to generate.
[Timespan]$Duration = $(
    if ($this.BPM -is [TimeSpan]) {$this.BPM} 
    else { [TimeSpan]::FromSeconds(60/128) }
),

# The volume
[double]$Volume = $(
    if ($this.Volume) { $this.Volume } else { 1/([Math]::PI * 2) }
),

# The start time.
$Time,

# The weights for each frequency.
# If multiple frequencies are played, 
# each wave will be scaled by the weight.
# If fewered weights are provided than frequencies, 
# all remaining frequencies will be half of the previous weight.
[double[]]$Weights = @(1.0),

# The sample rate.
# Will default to the `.SampleRate` of `$this` wave.
# If there is no `$this` wave, will default to 44100
[uint32]$SampleRate = $(
    if ($this.SampleRate) { $this.SampleRate } else { 44100 }
),

# The channel count.
# Will default to the `.ChannelCount` of `$this` wave.
# If there is no `$this` wave, will default to 1 (mono).
[uint16]$channelCount = $(
    if ($this.ChannelCount) { $this.ChannelCount } else { 1 }
)
)


# Squares peak sharply, so adjust volume accordingly.
$volume/=2

# This is the new wave.
$newWave = $this
if (-not $newWave) { $newWave = wave }

# If we don't have the time, add to the end.
if (-not $time) { $time = $newWave.Duration }

# We want to use WaveLinq for performance.
# This output a continous stream of samples,
# but only when we invoke the wave method.

$WaveForm = [Wave.WaveLinq]::CircleSquareWave

# This means:
# 1. We can have a _very_ fast audio object pipeline
# 2. We can generate and add our sample in one expression chain
# 3. We write it inline "outside in"

# We're adding to the new wave;
return $newWave.Add(
    [double[]]@(
        # a fading enveloping
        [Wave.WaveLinq]::FadeOut(
            # containing our wave
            $WaveForm.Invoke(
                $Duration.TotalSeconds, # for our duration,
                ($Frequency -as [double[]]), # at our frequencies,
                $Weights, # with our weights,                
                [uint32](
                    $SampleRate * $channelCount # at our samples per second.                    
                )
            ),
        $volume # We scale the whole thing to our volume
        )
    ), $time # and add it at the specified time.
)

                    </Script>
      </ScriptMethod>
      <ScriptMethod>
        <Name>CircleTriangle</Name>
        <Script>
                        &lt;#
.SYNOPSIS
